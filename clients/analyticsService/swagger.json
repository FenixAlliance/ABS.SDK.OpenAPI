    "/api/v2/AnalyticsService/Queries/Execute": {
      "post": {
        "tags": [
          "Queries"
        ],
        "summary": "Execute a governed analytics query",
        "description": "Compiles a declarative AnalyticsQuerySpec (identifiers only) into a tenant-scoped, permission-checked, typed EF GroupBy aggregate and returns the shaped AnalyticsResult. Rejects unknown/unauthorized datasets, non-allowlisted measures/dimensions/filters, invalid value types, and over-cap queries.",
        "operationId": "Queries_Execute",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-version",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsQuerySpec"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsQuerySpec"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResultEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResultEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
