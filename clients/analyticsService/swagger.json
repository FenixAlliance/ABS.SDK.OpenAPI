  "paths": {
    "/api/v2/AnalyticsService/Datasets": {
      "get": {
        "tags": [
          "Datasets"
        ],
        "summary": "Get the permission-scoped analytics catalog",
        "description": "Returns the self-describing catalog of governed analytics datasets the caller can query for the tenant — identifiers, labels and presentation hints only (no column names, data types, SQL or OData). A caller only sees datasets whose required permission they hold; an empty list is a valid result.",
        "operationId": "Datasets_GetCatalog",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-version",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsDatasetCatalogDtoListEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsDatasetCatalogDtoListEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
